DATABASE_URL="file:./dev.db"
JWT_SECRET="troca-por-um-segredo-forte-em-producao"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Horas que um pedido novo segura uma vaga antes de a libertar sozinho. Só a
# confirmação consome vaga; passado este prazo a reserva expira e o lugar volta
# a estar disponível, sem o pedido se perder.
RESERVA_TTL_HORAS=48
ADMIN_EMAIL="admin@colo.ao"
ADMIN_PASSWORD="define-uma-palavra-passe-forte"

# URL pública do site, para os links que vão para fora (o link de recuperação
# de palavra-passe). Sem esta variável o código cai no primeiro domínio de
# CORS_ORIGIN, que em produção já é o certo.
PANO_URL="https://colo.ao"

# Email — só para a recuperação de palavra-passe. Transporte SMTP.
# No Brevo: Definições da conta > SMTP & API > separador SMTP >
# "Generate a new SMTP key". A chave SMTP é o utilizador E a palavra-passe
# (não é a password da conta Brevo, nem uma API key — o Brevo recusa-as).
# A porta 587 liga com STARTTLS; a 465 exige SSL/TLS logo à ligação.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="xsmtpsib-a-chave-smtp"
SMTP_PASS="xsmtpsib-a-chave-smtp"
# Remetente. O Brevo só envia para remetentes verificados: ou um endereço do
# domínio autenticado (DKIM + SPF no DNS) ou um @brevo.com. Sem o domínio
# autenticado, mandar como colo.ao é rejeitado e os emails chegam ao spam.
# Só o endereço. O nome que aparece ao lado do avatar vai em EMAIL_FROM_NAME,
# separado — senão o nome sai duas vezes no cabeçalho do email.
EMAIL_FROM="nao-responder@colo.ao"
EMAIL_FROM_NAME="Colo"
# Para onde vai um "Responder". Sem isto, quem desconfiar do email de recuperação
# não tem onde escrever para desfazer a dúvida — e o endereço de resposta
# tem de ser uma caixa que alguém leia mesmo. O correio de colo.ao vive no
# Hostinger (mx1/mx2.hostinger.com), por isso este endereço só funciona se
# existir uma caixa com esse nome lá.
EMAIL_REPLY_TO="geral@colo.ao"
# Ficheiro do logotipo embutido nos emails. Vai dentro da imagem da API
# (ver docker/api.Dockerfile); só é preciso mudar se a dona trocar a marca.
EMAIL_LOGO_PATH="/app/assets/img/logo-email.png"
