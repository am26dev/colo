// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// SQLite: ficheiro único, sem servidor de BD para gerir na VPS.
// Suficiente para este projecto (site institucional + painel de 1 utilizadora).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não suporta enums nativos no Prisma: validado como string na
// camada da API (zod). Estados usados: "aberto" | "fechado" | "oculto".
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id                    Int      @id @default(1)
  whatsapp              String   @default("")
  instagram             String   @default("")
  dominio               String   @default("")
  moeda                 String   @default("Kz")
  mensagemDaSemana      String   @default("")
  pagamento             Json     @default("[]")
  // true = a semana activa é escolhida pelo intervalo de datas (dataInicio/dataFim);
  // false = a dona escolhe explicitamente qual Week fica activa (Week.ativaManual).
  modoAutomaticoSemanas Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// Uma semana = o pacote semanal completo vendido pela Colo (preço único,
// 5 dias, cada dia com 4 refeições). Substitui o antigo MenuState+Dish
// (pratos avulsos com preço individual).
model Week {
  id             String   @id @default(cuid())
  dataInicio     DateTime
  dataFim        DateTime
  precoSemanal   Int      @default(100000)
  estado         String   @default("aberto")
  vagasTotais    Int      @default(0)
  vagasRestantes Int      @default(0)
  // true só quando o *sistema* fechou a semana por esgotamento (a última vaga
  // foi consumida). Sem esta marca não dá para distinguir um fecho automático
  // de um fecho feito à mão pela dona, e devolver uma vaga tinha de reabrir a
  // semana a sério — o que passava por cima de um fecho deliberado.
  // Qualquer acção manual (toggle, PUT) volta a pôr a false.
  fechadaPorEsgotamento Boolean @default(false)
  // só relevante quando SiteConfig.modoAutomaticoSemanas = false
  ativaManual    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dias           Day[]
  pedidos        Order[]
}

model Day {
  id        String @id @default(cuid())
  weekId    String
  week      Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  diaSemana Int // 1=Segunda … 5=Sexta
  tema      String @default("") // ex.: "Leveza & Frescura"
  icone     String @default("") // emoji do dia
  frase     String @default("") // frase de carinho do dia
  // [{ tipo: "almoco"|"sobremesa", nome, descricao, foto }]
  // Json em vez de 12 colunas planas — mesmo padrão já usado em SiteConfig.pagamento
  refeicoes Json   @default("[]")

  @@unique([weekId, diaSemana])
}

model Order {
  id        String   @id @default(cuid())
  weekId    String?
  week      Week?    @relation(fields: [weekId], references: [id], onDelete: SetNull)
  tipo      String   @default("semana") // "semana" | "especial"
  nome      String
  contacto  String
  ciclo     String   @default("")
  notas     String   @default("") // pedido especial: descrição livre do que a cliente quer
  // "novo" (reserva activa, ainda sem vaga consumida) | "confirmado" (vaga
  // consumida) | "cancelado" | "expirado" (reserva que passou o prazo).
  estado    String   @default("novo")
  createdAt DateTime @default(now())
  // Reservas "novo" só bloqueiam uma vaga até esta data. Passado o prazo a
  // reserva é libertada (de forma passiva, nas contagens, e de forma explícita
  // na varredura preguiçosa) sem perder o pedido: a dona pode continuar a
  // confirmar à mão. Null em pedidos confirmados ou cancelados.
  expiresAt DateTime?

  @@index([weekId, estado])
  @@index([expiresAt])
}

// Key-value store para o modo edição no local.
// Cada chave é um identificador único (ex.: "hero.title.pre", "footer.tagline")
// e o valor é armazenado como JSON string.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}